# ---- Server ----
NODE_ENV=development
PORT=4000

# Frontend origin allowed by CORS (comma-separated for multiple)
CLIENT_ORIGIN=http://localhost:5173

# ---- Database (PostgreSQL) ----
# Local docker-compose default; replace with your Neon/Supabase URL in production
DATABASE_URL=postgresql://stockflow:stockflow@localhost:5432/stockflow?schema=public

# ---- Auth (generate long random strings, e.g. `openssl rand -hex 32`) ----
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
